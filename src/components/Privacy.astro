---
/* =====================================================================
   Privacy — страница политики конфиденциальности (одна разметка на три языка).
   Текст политики лежит в src/content/privacy/{ru,ro,en}.html (перенесён из v1-seo без правок).
   Шапка и футер — упрощённые: логотип, «на главную», языки, кнопка «Настройки cookie».
   ===================================================================== */
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CookieBanner from './CookieBanner.astro';
import ru from '../content/privacy/ru.html?raw';
import ro from '../content/privacy/ro.html?raw';
import en from '../content/privacy/en.html?raw';
import type { Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
// Заголовок, описание и подпись ссылки «на главную» — как в старой версии
const META = {
  ru: { title: 'Политика конфиденциальности — MX Systems', description: 'Какие данные собирает сайт MX Systems, зачем, где они хранятся и как отозвать согласие.', back: '← На главную' },
  ro: { title: 'Politica de confidențialitate — MX Systems', description: 'Ce date colectează site-ul MX Systems, de ce, unde sunt păstrate și cum vă puteți retrage consimțământul.', back: '← Pagina principală' },
  en: { title: 'Privacy policy — MX Systems', description: 'What data the MX Systems website collects, why, where it is stored and how to withdraw consent.', back: '← Home' },
}[lang];
const body = { ru, ro, en }[lang];
---
<Base lang={lang} title={META.title} description={META.description} page="/privacy/">
  <Header lang={lang} variant="simple" page="/privacy/" back={META.back} />
  <main class="legal">
    <div class="container"><div class="legal-in" set:html={body} /></div>
  </main>
  <Footer lang={lang} variant="simple" />
  <CookieBanner lang={lang} />
</Base>

<style>
  /* Документ: узкая колонка для чтения (≈ 70 символов в строке), ритм из шкалы отступов */
  .legal { padding: clamp(48px, 6vw, 96px) 0 var(--s-9); }
  .legal-in { max-width: 760px; }
  .legal-in :global(h1) { margin: var(--s-5) 0 var(--s-4); font: 500 clamp(40px, 5.4vw, 72px) / 1 var(--f-serif); letter-spacing: var(--track-tight); }
  .legal-in :global(h2) { margin: var(--s-7) 0 var(--s-3); font: 500 var(--fs-h3) / 1.15 var(--f-serif); }
  .legal-in :global(p), .legal-in :global(li) { color: var(--text-2); }
  .legal-in :global(p + p) { margin-top: var(--s-3); }
  .legal-in :global(ul) { display: grid; gap: var(--s-2); margin-top: var(--s-3); }
  .legal-in :global(li) { position: relative; padding-left: var(--s-5); }
  .legal-in :global(li)::before { content: "—"; position: absolute; left: 0; color: var(--accent); }
  .legal-in :global(b) { color: var(--text); }
  .legal-in :global(a) { color: var(--accent); border-bottom: 1px solid var(--accent-soft); }
  .legal-in :global(table) { width: 100%; margin-top: var(--s-3); border-collapse: collapse; font-size: 14px; }
  .legal-in :global(th), .legal-in :global(td) { padding: 10px var(--s-2) 10px 0; border-bottom: 1px solid var(--line-2); text-align: left; vertical-align: top; }
  .legal-in :global(th) { font: 400 11px/1.3 var(--f-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3); }
  .legal-in :global(td) { color: var(--text-2); }
  .legal-in :global(.meta) { margin-bottom: var(--s-7); font: 400 var(--fs-mono) / 1.5 var(--f-mono); color: var(--text-3); }
  /* Таблица не помещается на телефоне — прокручивается внутри своего блока */
  .legal-in :global(.table-scroll) { overflow-x: auto; }
</style>
