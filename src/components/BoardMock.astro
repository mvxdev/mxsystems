---
/* =====================================================================
   BoardMock — живой макет доски машин 4Power (упрощённая копия на ДЕМО-данных:
   модели машин без госномеров, без имён клиентов).
   Раз в несколько секунд одна машина «получает деталь» и плавно переезжает в колонку
   «Готова», внизу всплывает «Клиенту ушло сообщение» — затем всё возвращается.
   Логика — src/scripts/mocks.ts (FLIP-анимация, только transform), работает только пока
   макет на экране. Тексты статусов для анимации — в data-labels на языке страницы.
   aria-hidden — для скринридеров это декорация; описание даёт .sr-only в Case.astro.
   ===================================================================== */
import type { Dict } from '../i18n';
interface Props { ui: Dict['case4power']['ui'] }
const { ui } = Astro.props;
---
<div class="ui" id="board-4p" aria-hidden="true">
  <div class="ui-bar"><i class="live-dot"></i><span>{ui.bar}</span><span class="r">{ui.demo}</span></div>
  <div class="ui-sub">{ui.sub.map((s) => <span>{s}</span>)}</div>
  <div class="board">
    {ui.cols.map((col) => (
      <div class="col" data-col={col.key}>
        <p class="col-h">{col.title} <span class="cnt">{col.cars.length}</span></p>
        <div class="col-cards">
          {col.cars.map((car) => (
            <div class={`car ${car.cls}`.trim()} data-moving={car.moving ? '' : undefined}
                 data-labels={car.moving ? JSON.stringify(ui.labels) : undefined}>
              <b>{car.name}</b><span class="car-status">{car.status}</span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
  <div class="toast">{ui.toast}</div>
</div>

<!-- is:global — стили без «привязки» к компоненту: элементы, которые создаёт скрипт,
     тоже должны их получать. Все селекторы начинаются с .ui — за пределы макетов они не выходят -->
<style is:global>
  /* Общий вид «окна приложения» — одинаковый у обоих макетов (класс .ui) */
  .ui {
    position: relative; overflow: hidden;
    border: 1px solid var(--line-2); border-radius: var(--radius);
    background: var(--surface); box-shadow: var(--shadow-2);
    font-family: var(--f-mono);
  }
  .ui-bar { display: flex; align-items: center; gap: var(--s-3); height: 44px; padding: 0 var(--s-4); border-bottom: 1px solid var(--line-2); font-size: 11.5px; letter-spacing: 0.07em; text-transform: uppercase; }
  .ui-bar .r { margin-left: auto; padding: 3px 7px; border: 1px solid var(--line-2); border-radius: var(--radius); color: var(--text-3); font-size: 10.5px; }
  .ui-sub { display: flex; flex-wrap: wrap; gap: 6px var(--s-4); padding: 10px var(--s-4); border-bottom: 1px solid var(--line); font-size: 11.5px; color: var(--text-3); }
  .ui-sub span + span::before { content: "·"; margin-right: var(--s-4); color: var(--line-3); }

  /* Доска: три колонки статусов */
  .ui .board { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-2); min-height: 316px; padding: var(--s-4) var(--s-4) 68px; }
  .ui .col { min-width: 0; padding: 10px var(--s-2); border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg); }
  .ui .col-h { display: flex; justify-content: space-between; gap: 6px; margin: 0 0 10px; font: 400 10.5px/1.3 var(--f-mono); letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-3); }
  .ui .cnt { min-width: 18px; padding: 1px 5px; border-radius: var(--radius); background: var(--raised); color: var(--text); text-align: center; }
  .ui .col-cards { display: grid; gap: var(--s-2); }

  /* Карточка машины: модель — крупно, статус — моно; цветная полоса слева — состояние */
  .ui .car {
    position: relative; padding: 10px 10px 10px 12px;
    border: 1px solid var(--line-2); border-radius: var(--radius);
    background: var(--raised); box-shadow: var(--shadow-1);
    transition: opacity var(--dur-2) var(--ease), border-color var(--dur-2) var(--ease);
  }
  .ui .car::before { content: ""; position: absolute; left: -1px; top: 8px; bottom: 8px; width: 2px; border-radius: 2px; background: var(--line-3); }
  .ui .car b { display: block; margin-bottom: 4px; font: 500 14px/1.25 var(--f-sans); color: var(--text); }
  .ui .car-status { display: block; font-size: 10.5px; line-height: 1.35; color: var(--text-3); }
  .ui .car.is-fading { opacity: 0; }
  .ui .car.is-urgent::before, .ui .car.is-hot::before { background: var(--accent); }
  .ui .car.is-urgent .car-status { color: var(--accent); }
  .ui .car.is-hot { border-color: var(--accent-soft); }
  .ui [data-col="ready"] .car::before { background: var(--ok); }
  .ui [data-col="ready"] .car .car-status { color: var(--ok); }

  /* Всплывашка «клиенту ушло сообщение» — снизу */
  .ui .toast {
    position: absolute; left: var(--s-4); right: var(--s-4); bottom: var(--s-4);
    padding: var(--s-3) var(--s-4); border: 1px solid var(--ok-soft); border-radius: var(--radius);
    background: #0f1a14; font-size: 12px; color: var(--ok);
    opacity: 0; transform: translateY(10px);
    transition: opacity var(--dur-2) var(--ease), transform var(--dur-2) var(--ease);
  }
  .ui .toast.is-on { opacity: 1; transform: none; }

  @media (max-width: 480px) {
    .ui .board { gap: 6px; padding: 10px 10px 64px; min-height: 300px; }
    .ui .col { padding: var(--s-2) 6px; }
    .ui .car { padding: var(--s-2) 6px var(--s-2) 8px; }
    .ui .car b { font-size: 12.5px; }
    .ui .col-h { font-size: 9.5px; flex-direction: column; gap: 4px; }
    .ui .cnt { align-self: flex-start; }
  }
</style>
