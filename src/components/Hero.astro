---
/* =====================================================================
   Hero — первый экран, «обложка журнала».
   Раскладка по 12-колоночной сетке (как в старой версии):
     • строка «выходных данных» сверху: направления · город · «с 2019»;
     • заголовок H1 — колонки 1–8, схема — колонки 9–12;
     • нижняя полоса во всю ширину: текст (1–5) · кнопки (6–9) · сноски-кейсы (10–12).
   На телефоне: заголовок → текст → кнопки → сноски → схема.
   H1 — главный элемент первого экрана (LCP): он появляется без задержки и без lazy.
   ===================================================================== */
import Scheme from './Scheme.astro';
import { t, tgHref, type Lang } from '../i18n';
import { typo, tt } from '../i18n/typo';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const h = d.hero;
const sup = ['¹', '²'];
---
<div class="container">
  <p class="masthead">
    <span>{d.masthead[0]}</span><span class="mid">{d.masthead[1]}</span><span class="end">{d.masthead[2]}</span>
  </p>
</div>

<section class="hero" aria-labelledby="hero-title">
  <div class="container grid cover">
    <h1 class="h1" id="hero-title"><span class="prefix">{h.h1Prefix}</span><Fragment set:html={typo(h.h1, lang)} /></h1>

    <Scheme lang={lang} />

    <div class="row">
      <p class="lead" set:html={typo(h.lead, lang)} />
      <div class="actions">
        <a class="btn btn--primary" href={tgHref(lang)} target="_blank" rel="noopener">
          <span><Fragment set:html={tt(h.cta, lang)} /><small class="btn-sub" set:html={tt(h.ctaSub, lang)} /></span><span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn" href="#cases">{h.cta2} <span class="arrow" aria-hidden="true">↓</span></a>
      </div>
      <!-- Строка доверия в виде журнальных сносок — каждая ведёт к своему кейсу -->
      <ul class="notes" aria-label={h.notesAria}>
        {h.notes.map((n, i) => (
          <li><sup>{sup[i]}</sup><a href={n.href}><span class="k">{n.k}</span><br>{n.text}</a></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* Строка «выходных данных» обложки: три колонки на десктопе, две на телефоне */
  .masthead {
    display: grid; grid-template-columns: 1fr auto; gap: var(--s-4);
    padding-block: var(--s-3); border-bottom: 1px solid var(--line);
    font: 400 var(--fs-mono) / 1.3 var(--f-mono); letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--text-3);
  }
  .masthead .mid { display: none; }
  @media (min-width: 900px) {
    .masthead { grid-template-columns: 1fr auto 1fr; }
    .masthead .mid { display: block; }
    .masthead .end { text-align: right; }
  }

  .hero { padding: clamp(32px, 4.4vw, 64px) 0 clamp(56px, 6vw, 88px); }
  .cover { row-gap: var(--s-7); align-items: end; }

  /* H1: крупно, плотно, с курсивным оранжевым акцентом */
  .h1 {
    font: 500 var(--fs-h1) / var(--lh-tight) var(--f-serif);
    letter-spacing: var(--track-tight);
    font-feature-settings: "kern", "liga", "dlig";
  }
  /* «MX Systems» — мелкая моно-строка над заголовком (часть H1 для поисковиков) */
  .prefix { display: block; margin-bottom: 1.4em; font: 400 var(--fs-mono) / 1 var(--f-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-3); }

  /* Нижняя полоса: тонкая линия сверху, вертикальные линии между колонками */
  .row { display: grid; gap: var(--s-6); padding-top: var(--s-5); border-top: 1px solid var(--line-3); }
  .lead { max-width: 46ch; font-size: var(--fs-lead); line-height: 1.55; color: var(--text-2); }
  .actions { display: flex; flex-direction: column; gap: var(--s-2); }
  .actions .btn { width: 100%; }

  /* Сноски ¹ ² — как примечания в журнале */
  .notes { font-size: var(--fs-small); color: var(--text-2); }
  .notes li { display: flex; gap: var(--s-3); padding: var(--s-2) 0; border-bottom: 1px solid var(--line); }
  .notes li:first-child { padding-top: 0; }
  .notes sup { font: 500 12px/1.7 var(--f-mono); color: var(--accent); top: 0; }
  .notes a { line-height: 1.45; transition: color var(--dur-1); }
  .notes a:hover { color: var(--text); }
  .notes .k { font: 400 11.5px/1.9 var(--f-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--text); }

  /* Десктоп: модульная сетка 12 колонок */
  @media (min-width: 1100px) {
    .h1 { grid-column: 1 / span 8; grid-row: 1; align-self: center; }
    .cover :global(.fig) { grid-column: 9 / span 4; grid-row: 1; }
    .row { grid-column: 1 / -1; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); }
    .lead { grid-column: 1 / span 5; }
    .actions { grid-column: 6 / span 4; padding-left: var(--col-gap); border-left: 1px solid var(--line); }
    .notes { grid-column: 10 / span 3; padding-left: var(--col-gap); border-left: 1px solid var(--line); }
  }
  /* Планшет: текст и кнопки рядом, сноски ниже */
  @media (min-width: 700px) and (max-width: 1099px) {
    .row { grid-template-columns: 1fr 1fr; column-gap: var(--s-6); }
    .notes { grid-column: 1 / -1; }
  }
  /* Телефон и планшет: схема после текста и кнопок */
  @media (max-width: 1099px) {
    .cover :global(.fig) { order: 3; max-width: 520px; }
  }

  /* Телефон: плотнее, чтобы заголовок, текст и главная кнопка были в первом экране */
  @media (max-width: 699px) {
    .masthead { letter-spacing: 0.05em; font-size: 11px; grid-template-columns: 1fr; }
    .masthead .end { display: none; }   /* «с 2019» на телефоне есть в подписи к фото автора */
    .hero { padding-top: var(--s-5); }
    .cover { row-gap: var(--s-6); }
    .prefix { margin-bottom: var(--s-4); }
    .row { gap: var(--s-5); padding-top: var(--s-4); }
    .lead { font-size: 16px; line-height: 1.5; }
  }

  /* Появление первого экрана при загрузке — сразу, по очереди (только transform/opacity).
     Заголовок (LCP) не скрываем: он виден с первого кадра, сдвигается только чуть-чуть */
  .h1, .row { animation: hero-rise var(--dur-3) var(--ease) both; }
  .row { animation-delay: calc(var(--stagger) * 3); }
  .cover :global(.fig) { animation: hero-fade var(--dur-3) var(--ease) calc(var(--stagger) * 2) both; }
  @keyframes hero-rise { from { transform: translateY(12px); } }
  @keyframes hero-fade { from { opacity: 0; transform: translateY(12px); } }
</style>
