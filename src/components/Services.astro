---
/* =====================================================================
   Services — «03 / Услуги». На десктопе — таблица во всю ширину:
   № · услуга · что входит · срок · цена (+ стрелка). Колонки таблицы стоят на той же
   12-колоночной сетке, что и вся страница: № — 1, услуга — 2–4, описание — 5–8,
   срок — 9–10, цена — 11–12. Строка подсвечивается при наведении, стрелка сдвигается.
   На телефоне каждая строка — карточка: номер и название, описание, ниже срок и цена
   с подписями. Цены — моно-шрифтом, выровнены и читаются сразу.
   Шесть услуг; цены — ровно как на сайте (они же уходят в JSON-LD).
   ===================================================================== */
import SectionHead from './SectionHead.astro';
import { typo, tt } from '../i18n/typo';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).services;
---
<section class="section" id="services" aria-labelledby="services-title">
  <div class="container">
    <SectionHead lang={lang} n="03" eyebrow={s.eyebrow} title={s.title} intro={s.intro} id="services-title" />

    <!-- Шапка таблицы — только на десктопе (на телефоне подписи стоят в каждой карточке) -->
    <div class="svc-head grid" aria-hidden="true">
      {s.head.map((h, i) => <span class={`c${i}`}>{h}</span>)}
    </div>
    <ul class="svc-list stagger">
      {s.items.map((it) => (
        <li>
          <a class="svc grid" href="#contact">
            <span class="svc-n c0">{it.n}</span>
            <span class="svc-name c1">{it.name}</span>
            <span class="svc-desc c2" set:html={typo(it.desc, lang)} />
            <span class="svc-term c3"><small>{it.termLabel}</small><Fragment set:html={tt(it.term, lang)} /></span>
            <span class="svc-price c4"><small>{it.priceLabel}</small>{it.price.map((p) => <span class="p" set:html={typo(p, lang)} />)}</span>
            <span class="svc-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .svc-head { display: none; }
  .svc-list { border-top: 1px solid var(--line-3); }
  .svc-list li { border-bottom: 1px solid var(--line-2); }

  .svc { position: relative; isolation: isolate; row-gap: var(--s-3); padding: var(--s-5) 0; }
  .svc-n { font: 400 var(--fs-mono-lg) / 1.9 var(--f-mono); color: var(--accent); }
  .svc-name { font: 500 clamp(28px, 2.5vw, 36px) / 1.05 var(--f-serif); letter-spacing: -0.01em; transition: transform var(--dur-2) var(--ease); }
  .svc-desc { color: var(--text-2); font-size: var(--fs-small); line-height: 1.55; }
  .svc-term, .svc-price { font: 400 14px/1.45 var(--f-mono); }
  .svc-price { color: var(--text); }
  .svc-price .p { display: block; }
  .svc-term { color: var(--text-2); }
  .svc small { display: block; margin-bottom: var(--s-1); font: 400 11px/1.3 var(--f-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3); }
  .svc-arrow { position: absolute; right: 0; top: var(--s-5); font-family: var(--f-mono); color: var(--text-3); transition: transform var(--dur-2) var(--ease), color var(--dur-1); }

  /* Телефон: № + название в строку, описание, затем срок и цена в две колонки */
  @media (max-width: 999px) {
    .svc { grid-template-columns: 44px 1fr 1fr; column-gap: var(--s-4); }
    .c0 { grid-column: 1; grid-row: 1; }
    .c1 { grid-column: 2 / -1; grid-row: 1; padding-right: var(--s-6); }
    .c2 { grid-column: 2 / -1; }
    .c3 { grid-column: 2; padding-top: var(--s-2); border-top: 1px solid var(--line); }
    .c4 { grid-column: 3; padding-top: var(--s-2); border-top: 1px solid var(--line); }
  }

  /* Десктоп: таблица на 12-колоночной сетке */
  @media (min-width: 1000px) {
    .svc-head { display: grid; padding-bottom: var(--s-3); font: 400 11px/1 var(--f-mono); letter-spacing: var(--track-caps); text-transform: uppercase; color: var(--text-3); }
    .svc { align-items: baseline; padding: 28px 0; }
    .c0 { grid-column: 1; }
    .c1 { grid-column: 2 / span 3; }
    .c2 { grid-column: 5 / span 4; max-width: 56ch; }
    .c3 { grid-column: 9 / span 2; }
    .c4 { grid-column: 11 / span 2; padding-right: var(--s-6); }
    .svc small { display: none; }
    .svc-arrow { top: 50%; transform: translateY(-50%); }
    /* Подсветка строки: фон заливается слева направо (как у кнопок) и выходит чуть за края */
    .svc::before {
      content: ""; position: absolute; inset: 0 calc(var(--s-4) * -1); z-index: -1;
      background: var(--surface); border-radius: var(--radius);
      transform: scaleX(0); transform-origin: left; transition: transform var(--dur-2) var(--ease);
    }
    .svc:hover::before, .svc:focus-visible::before { transform: scaleX(1); }
    .svc:hover .svc-name { transform: translateX(6px); }
    .svc:hover .svc-arrow { transform: translate(4px, -50%); color: var(--accent); }
  }
</style>
