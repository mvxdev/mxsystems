---
/* =====================================================================
   Process — «05 / Как работаем»: четыре шага как связанный путь.
   На десктопе шаги в ряд (по 3 колонки сетки), над ними — линия-путь с точками,
   которая «прорисовывается» слева направо, когда секция появилась. На телефоне путь
   вертикальный, слева. Первый шаг (разговор без обязательств) — закрашенная точка.
   Ниже — «Всё остаётся у вас»: заголовок (колонки 1–4) и три пункта (5–12) с иконками
   в едином тонком линейном стиле (нарисованы здесь же, SVG, толщина линии 1.25).
   ===================================================================== */
import SectionHead from './SectionHead.astro';
import { typo } from '../i18n/typo';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = t(lang).process;
// Иконки «Всё остаётся у вас»: ключ (код и доступы), документ, открытый замок (свобода выбора)
const icons = [
  '<circle cx="8" cy="15" r="4.25"/><path d="m11 12 8.5-8.5M16.5 6.5l2.5 2.5M14.5 8.5l2 2"/>',
  '<path d="M6 3.5h8l4 4v13H6z"/><path d="M14 3.5v4h4M9 12h6M9 15h6M9 18h4"/>',
  '<rect x="5" y="11" width="14" height="9.5" rx="1.5"/><path d="M8.5 11V7.5a3.5 3.5 0 0 1 6.8-1.2M12 14.5v2.5"/>',
];
---
<section class="section" id="process" aria-labelledby="process-title">
  <div class="container">
    <SectionHead lang={lang} n="05" eyebrow={p.eyebrow} title={p.title} intro={p.intro} id="process-title" />

    <ol class="steps grid reveal">
      {p.steps.map((s) => (
        <li class="step">
          <span class="step-n">{s.n}</span>
          <h3 class="step-title">{s.title}</h3>
          <p set:html={typo(s.text, lang)} />
        </li>
      ))}
    </ol>

    <div class="own grid reveal">
      <h3 class="own-title" set:html={typo(p.ownTitle, lang)} />
      <ul class="own-list">
        {p.own.map((o, i) => (
          <li>
            <svg class="own-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i]} />
            <b>{o.title}</b>
            <span set:html={typo(o.text, lang)} />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* --- Путь из четырёх шагов --- */
  .steps { position: relative; row-gap: 0; }
  /* Линия пути: на телефоне вертикальная слева; «рисуется» при появлении (scaleY 0 → 1) */
  .steps::before {
    content: ""; position: absolute; left: 4px; top: 8px; bottom: 8px; width: 1px;
    background: var(--accent); transform: scaleY(0); transform-origin: top;
    transition: transform 1.2s var(--ease) 0.15s;
  }
  .steps:global(.is-in)::before, :global(html:not(.js)) .steps::before { transform: none; }
  .step { position: relative; padding: 0 0 var(--s-7) var(--s-7); }
  .step:last-child { padding-bottom: 0; }
  /* Точка-станция на линии у каждого шага */
  .step::before { content: ""; position: absolute; left: 0; top: 5px; width: 9px; height: 9px; border-radius: 50%; background: var(--bg); border: 1px solid var(--accent); }
  .step:first-child::before { background: var(--accent); }
  .step-n { display: block; margin-bottom: var(--s-3); font: 400 var(--fs-mono) / 1.35 var(--f-mono); letter-spacing: var(--track-caps); text-transform: uppercase; color: var(--accent); }
  .step-title { margin-bottom: var(--s-3); font: 500 var(--fs-h3) / var(--lh-head) var(--f-serif); letter-spacing: -0.01em; }
  .step p { max-width: 34ch; color: var(--text-2); font-size: var(--fs-small); }

  @media (min-width: 900px) {
    .steps { padding-top: var(--s-7); }
    .steps::before { left: 0; right: 0; top: 4px; bottom: auto; width: auto; height: 1px; transform: scaleX(0); transform-origin: left; }
    .steps > .step { grid-column: span 3; padding: 0 var(--s-5) 0 0; }
    .step::before { top: calc(var(--s-7) * -1); }
  }

  /* --- «Всё остаётся у вас» --- */
  .own { row-gap: var(--s-6); margin-top: clamp(72px, 8vw, 120px); padding-block: clamp(32px, 4vw, 56px); border-top: 1px solid var(--line-3); border-bottom: 1px solid var(--line-2); }
  .own-title { font: 500 clamp(36px, 4vw, 56px) / 1 var(--f-serif); letter-spacing: var(--track-tight); }
  .own-title :global(em) { font-style: italic; color: var(--accent); }
  .own-list { display: grid; gap: var(--s-6); }
  .own-list li { display: grid; gap: var(--s-3); align-content: start; }
  .own-ico { width: 32px; height: 32px; color: var(--accent); }
  .own-list b { font: 400 var(--fs-mono-lg) / 1.35 var(--f-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text); }
  .own-list span { color: var(--text-2); font-size: var(--fs-small); max-width: 32ch; }
  @media (min-width: 900px) {
    .own-title { grid-column: 1 / span 4; }
    .own-list { grid-column: 5 / span 8; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--col-gap); }
  }
</style>
