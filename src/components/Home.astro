---
/* =====================================================================
   Home — главная страница целиком (одна разметка на три языка).
   Порядок блоков — ровно как в старой версии:
     шапка → первый экран → 01 Проекты (кейсы + платформы) → 02 Кто делает → 03 Услуги →
     04 Калькулятор → 05 Как работаем → 06 Вопросы → 07 Контакт → футер → cookie-баннер.
   Страницы src/pages/index.astro, ro/index.astro, en/index.astro только передают язык.
   ===================================================================== */
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Cases from './Cases.astro';
import About from './About.astro';
import Services from './Services.astro';
import Calculator from './Calculator.astro';
import Process from './Process.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import CookieBanner from './CookieBanner.astro';
import { homeJsonLd } from '../lib/jsonld';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const m = t(lang).meta;
---
<Base lang={lang} title={m.title} description={m.description} ogTitle={m.ogTitle} ogDescription={m.ogDescription}
      jsonld={homeJsonLd(lang)} home={lang === 'ru'}>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <Cases lang={lang} />
    <About lang={lang} />
    <Services lang={lang} />
    <Calculator lang={lang} />
    <Process lang={lang} />
    <Faq lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
  <CookieBanner lang={lang} />
</Base>
