---
/* =====================================================================
   Products — «Платформы»: три работающих продукта (CarBids, FastLoad, 4Power · сайт и CRM).
   Три карточки одной высоты по 4 колонки сетки. Внутренние строки карточек выровнены
   между собой через subgrid: скриншоты, названия, описания и цифры внизу стоят на
   одних горизонталях во всех трёх карточках, даже если текст разной длины.
   Скриншоты — через astro:assets: AVIF/WebP нужного размера, lazy (ниже первого экрана).
   При наведении скриншот слегка увеличивается и сдвигается вверх.
   ===================================================================== */
import { Picture } from 'astro:assets';
import carbids from '../assets/products/carbids.jpg';
import fastload from '../assets/products/fastload.jpg';
import crm from '../assets/products/crm.jpg';
import { typo, tt } from '../i18n/typo';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = t(lang).products;
const IMG = { carbids, fastload, crm } as const;
---
<div class="products" id="products">
  <div class="products-head reveal">
    <p class="group-label">{p.label}</p>
    <h3 class="products-title" set:html={typo(p.title, lang)} />
  </div>
  <div class="prod-grid stagger">
    {p.items.map((it) => (
      <article class:list={['prod', { 'prod--offer': !!it.offer }]}>
        <div class="shot">
          <Picture src={IMG[it.img as keyof typeof IMG]} formats={['avif', 'webp']} widths={[480, 960]}
                   sizes="(min-width: 1000px) 416px, (min-width: 700px) 90vw, 100vw"
                   alt={it.alt} loading="lazy" decoding="async" />
        </div>
        <div class="prod-top">
          {it.badge && <span class="badge"><i class="live-dot"></i>{it.badge}</span>}
          {it.offer && <span class="badge badge--accent">{it.offer}</span>}
          <a class="prod-link" href={it.link.href} target="_blank" rel="noopener">{it.link.label}</a>
        </div>
        <h4 class="prod-name">{it.name}</h4>
        <p class="prod-what" set:html={tt(it.what, lang)} />
        <p class="prod-desc" set:html={typo(it.desc, lang)} />
        {it.kpis.length > 0 && (
          <dl class="prod-kpis">{it.kpis.map((k) => <div><dt set:html={tt(k.dt, lang)} /><dd set:html={tt(k.dd, lang)} /></div>)}</dl>
        )}
        {it.cta && <a class="btn btn--small btn--primary prod-cta" href={it.cta.href}><Fragment set:html={tt(it.cta.label, lang)} /> <span class="arrow" aria-hidden="true">→</span></a>}
      </article>
    ))}
  </div>
</div>

<style>
  .products { margin-top: clamp(64px, 7vw, 112px); }
  .products-head { margin-bottom: clamp(32px, 4vw, 48px); }
  .products-title { margin-top: var(--s-5); font: 500 clamp(34px, 4.4vw, 60px) / 1.02 var(--f-serif); letter-spacing: var(--track-tight); max-width: 18ch; }
  .products-title :global(em) { font-style: italic; color: var(--accent); }

  .prod-grid { display: grid; gap: var(--col-gap); }
  .prod {
    display: flex; flex-direction: column; gap: var(--s-3);
    padding: var(--s-5); border: 1px solid var(--line-2); border-radius: var(--radius);
    background: var(--surface);
    transition: border-color var(--dur-2) var(--ease);
  }
  .prod:hover { border-color: var(--line-3); }
  @media (min-width: 1000px) {
    /* 3 карточки × 4 колонки. 6 строк: снимок · верх · название · подзаголовок · описание · низ */
    .prod-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(6, auto); }
    .prod { grid-row: span 6; display: grid; grid-template-rows: subgrid; row-gap: var(--s-3); }
    .prod-kpis { align-self: end; }
    .prod-cta { align-self: end; justify-self: start; }
  }

  /* Рамка скриншота: overflow hidden — увеличенная картинка не вылезает за края */
  .shot { overflow: hidden; margin-bottom: var(--s-2); border: 1px solid var(--line-2); border-radius: var(--radius); aspect-ratio: 16 / 10; background: var(--raised); }
  .shot :global(img) { width: 100%; height: 100%; object-fit: cover; transform-origin: 50% 0; transition: transform var(--dur-3) var(--ease); }
  .prod:hover .shot :global(img) { transform: scale(1.04) translateY(-1.5%); }

  .prod-top { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
  .prod-link { font: 400 12.5px/1 var(--f-mono); color: var(--accent); border-bottom: 1px solid var(--accent-soft); padding-bottom: 3px; transition: border-color var(--dur-1); }
  .prod-link:hover { border-color: var(--accent); }
  .prod-name { font: italic 500 clamp(32px, 2.8vw, 42px) / 1 var(--f-serif); letter-spacing: -0.01em; }
  .prod-what { font: 400 12px/1.45 var(--f-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-3); }
  .prod-desc { color: var(--text-2); font-size: var(--fs-small); }

  /* Цифры внизу — на одной линии во всех карточках (последняя строка subgrid прижата к низу) */
  /* align-self: end — в subgrid прижимает ряд цифр к низу карточки (на одной линии у всех трёх) */
  .prod-kpis { display: flex; flex-wrap: wrap; gap: var(--s-4) var(--s-6); margin-top: var(--s-3); padding-top: var(--s-4); border-top: 1px solid var(--line); }
  .prod-kpis dt { font: 500 24px/1.1 var(--f-mono); letter-spacing: -0.03em; color: var(--text); white-space: nowrap; }
  .prod-kpis dd { margin-top: var(--s-1); font: 400 11px/1.35 var(--f-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-3); }
  .prod-cta { align-self: flex-start; margin-top: var(--s-3); }
  @media (max-width: 999px) { .prod-kpis, .prod-cta { margin-top: var(--s-4); } }
</style>
