---
/* =====================================================================
   Scheme — схема на первом экране: откуда приходят данные (Реклама / Учёт / Почта),
   что делает система (MX Systems) и кто получает результат (Команда / Клиенты / Владелец).

   «Живая» схема без библиотек — встроенные анимации SVG (SMIL), только движение и прозрачность:
     • по каждому из 6 проводов бежит оранжевая точка-«данные»: сверху — в центр, из центра — вниз.
       Все анимации идут по одному циклу CYCLE секунд, у каждой точки своя задержка:
       сначала три входа по очереди приходят в центр, затем три выхода уходят вниз;
     • точка плавно появляется на старте и гаснет на финише;
     • когда точка доходит до узла, там вспыхивает и расходится оранжевое кольцо;
     • в момент прихода данных рамка карточки MX Systems едва заметно светится,
       а оранжевая точка в её углу «пульсирует» кольцом;
     • при наведении на любой блок подсвечивается его провод до центра (CSS, только opacity).
   Скрипт src/scripts/scheme.ts запускает анимацию, только пока схема на экране,
   а при «уменьшить движение» оставляет схему статичной (все точки и кольца скрыты).
   viewBox — «холст» 480×470 условных единиц; SVG сам масштабируется под ширину колонки.
   ===================================================================== */
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const h = t(lang).hero;

const CYCLE = 4;                                // длина цикла, секунды
const x = [0.5, 170.5, 340.5];                  // левые края блоков
const cx = x.map((v) => v + 69.5);              // середины блоков: 70, 240, 410

// Провода (координаты — как в старой версии). Вход: от кружка блока к верхнему краю ядра.
// Выход: от нижнего края ядра к кружку блока.
const inWires = [
  'M70 76 V140 Q70 172 130 176 L190 180 V206',
  'M240 76 V206',
  'M410 76 V140 Q410 172 350 176 L290 180 V206',
];
const outWires = [
  'M190 296 V312 L130 316 Q70 320 70 352 V394',
  'M240 296 V394',
  'M290 296 V312 L350 316 Q410 320 410 352 V394',
];
// Узлы, куда приходит точка: у входов — край ядра, у выходов — кружок блока
const inEnds = [[190, 206], [240, 206], [290, 206]];
const outEnds = cx.map((v) => [v, 394.5]);

// Расписание точек: старт (с) и время в пути (с). Входы приходят в центр в 1.4 / 1.7 / 2.0 с,
// выходы уходят после этого и приходят вниз к 3.3–3.8 с — до конца цикла.
const IN = [0, 0.3, 0.6].map((begin) => ({ begin, travel: 1.4 }));
const OUT = [2.0, 2.25, 2.5].map((begin) => ({ begin, travel: 1.3 }));
const dots = [
  ...IN.map((p, i) => ({ ...p, wire: `w${i + 1}`, end: inEnds[i] })),
  ...OUT.map((p, i) => ({ ...p, wire: `w${i + 4}`, end: outEnds[i] })),
];
// Доли цикла (0…1) для keyTimes, округлённые
const f = (s: number) => +(s / CYCLE).toFixed(3);
const dotTimes = dots.map((d) => {
  const arrive = f(d.travel);
  return {
    move: `0;${arrive};1`,
    fade: `0;0.05;${+(arrive - 0.03).toFixed(3)};${+(arrive + 0.03).toFixed(3)};1`,
    glow: `0;${+(arrive - 0.02).toFixed(3)};${+(arrive + 0.01).toFixed(3)};${+(arrive + 0.17).toFixed(3)};1`,
  };
});
// Свечение ядра — от прихода первой точки (1.4 с) до чуть позже последней (2.0 с)
const coreGlow = { values: '0;0;0.55;0.55;0;0', times: `0;${f(1.35)};${f(1.6)};${f(2.1)};${f(2.7)};1` };
const markRing = { times: `0;${f(1.4)};${f(1.5)};${f(2.8)};1` };
const dur = `${CYCLE}s`;
---
<figure class="fig" aria-label={h.figAria}>
  <svg viewBox="0 0 480 470" aria-hidden="true">
    <!-- Входы: провод + блок в одной группе — наведение на блок подсвечивает его провод -->
    {h.inputs.map((b, i) => (
      <g class="s-node">
        <path id={`w${i + 1}`} class="s-wire" d={inWires[i]} />
        <path class="s-wire-hi" d={inWires[i]} />
        <rect class="s-box" x={x[i]} y="16.5" width="139" height="60" rx="3" />
        <rect class="s-box-hi" x={x[i]} y="16.5" width="139" height="60" rx="3" />
        <text class="s-t" x={x[i] + 15.5} y="44">{b.t}</text>
        <text class="s-s" x={x[i] + 15.5} y="63">{b.s}</text>
        <circle class="s-port" cx={cx[i]} cy="76.5" r="2.5" />
      </g>
    ))}

    <!-- Выходы -->
    {h.outputs.map((b, i) => (
      <g class="s-node">
        <path id={`w${i + 4}`} class="s-wire" d={outWires[i]} />
        <path class="s-wire-hi" d={outWires[i]} />
        <rect class="s-box" x={x[i]} y="394.5" width="139" height="60" rx="3" />
        <rect class="s-box-hi" x={x[i]} y="394.5" width="139" height="60" rx="3" />
        <text class="s-t" x={x[i] + 15.5} y="422">{b.t}</text>
        <text class="s-s" x={x[i] + 15.5} y="441">{b.s}</text>
        <circle class="s-port" cx={cx[i]} cy="394.5" r="2.5" />
      </g>
    ))}

    <!-- Ядро — светлый блок, главный элемент рисунка; «дышит» в такт циклу -->
    <g class="s-core-g">
      <!-- рамка-свечение вокруг ядра: вспыхивает, когда приходят данные -->
      <rect class="s-core-glow" x="66" y="202" width="348" height="98" rx="5" opacity="0">
        <animate attributeName="opacity" dur={dur} repeatCount="indefinite" values={coreGlow.values} keyTimes={coreGlow.times} />
      </rect>
      <rect class="s-core" x="70" y="206" width="340" height="90" rx="3" />
      <text class="s-big" x="92" y="250">MX Systems</text>
      <text class="s-sub" x="92" y="276">{h.coreSub}</text>
      <!-- оранжевая точка в углу и расходящееся от неё кольцо -->
      <g transform="translate(390 226)">
        <circle class="s-ring" r="4" opacity="0">
          <animate attributeName="opacity" dur={dur} repeatCount="indefinite" values="0;0;0.8;0;0" keyTimes={markRing.times} />
          <animateTransform attributeName="transform" type="scale" dur={dur} repeatCount="indefinite" values="1;1;1;3.4;3.4" keyTimes={markRing.times} />
        </circle>
        <circle class="s-mark" r="4" />
      </g>
    </g>

    <!-- Кольца на узлах: вспыхивают, когда точка дошла (то же время начала, что у точки) -->
    {dots.map((d, i) => (
      <g transform={`translate(${d.end[0]} ${d.end[1]})`}>
        <circle class="s-ring" r="3.5" opacity="0">
          <animate attributeName="opacity" begin={`${d.begin}s`} dur={dur} repeatCount="indefinite" values="0;0;0.9;0;0" keyTimes={dotTimes[i].glow} />
          <animateTransform attributeName="transform" type="scale" begin={`${d.begin}s`} dur={dur} repeatCount="indefinite" values="1;1;1;2.8;2.8" keyTimes={dotTimes[i].glow} />
        </circle>
      </g>
    ))}

    <!-- Точки-данные: едут по проводу w1…w6, плавно появляются и гаснут -->
    {dots.map((d, i) => (
      <circle class="s-pulse" r="3.2" opacity="0">
        <animate attributeName="opacity" begin={`${d.begin}s`} dur={dur} repeatCount="indefinite" values="0;1;1;0;0" keyTimes={dotTimes[i].fade} />
        <animateMotion begin={`${d.begin}s`} dur={dur} repeatCount="indefinite" keyPoints="0;1;1" keyTimes={dotTimes[i].move} calcMode="spline" keySplines="0.45 0 0.25 1;0 0 1 1">
          <mpath href={`#${d.wire}`} />
        </animateMotion>
      </circle>
    ))}
  </svg>
  <figcaption>{h.figcaption}</figcaption>
</figure>

<style>
  .fig svg { width: 100%; height: auto; overflow: visible; }
  .fig figcaption {
    margin-top: var(--s-3); padding-top: var(--s-3); border-top: 1px solid var(--line-3);
    font: italic 500 18px/1.3 var(--f-serif); color: var(--text-2);
  }
  .s-box { fill: var(--bg); stroke: var(--line-3); }
  .s-wire { fill: none; stroke: var(--text); stroke-width: 1; opacity: 0.32; }
  .s-port { fill: var(--bg); stroke: var(--text); stroke-width: 1; opacity: 0.7; }
  .s-t { fill: var(--text); font: 500 14px var(--f-mono); letter-spacing: 0.05em; }
  .s-s { fill: var(--text-3); font: 400 12.5px var(--f-mono); }
  .s-core { fill: var(--text); }
  .s-big { fill: var(--bg); font: italic 600 34px var(--f-serif); }
  .s-sub { fill: rgb(13 12 10 / 0.68); font: 400 12.5px var(--f-mono); }
  .s-mark { fill: var(--accent); }
  .s-pulse { fill: var(--accent); }
  .s-ring { fill: none; stroke: var(--accent); stroke-width: 1.2; }
  .s-core-glow { fill: none; stroke: var(--accent); stroke-width: 1; }

  /* Наведение на блок: оранжевая копия провода и рамки проявляется поверх (только opacity) */
  .s-wire-hi, .s-box-hi { fill: none; stroke: var(--accent); opacity: 0; transition: opacity var(--dur-2) var(--ease); pointer-events: none; }
  .s-wire-hi { stroke-width: 1.3; }
  .s-wire { pointer-events: none; }
  .s-node:hover .s-wire-hi { opacity: 0.9; }
  .s-node:hover .s-box-hi { opacity: 0.6; }

  /* «Дыхание» ядра: едва заметное увеличение, в такт циклу данных (4 с).
     transform-box: fill-box — масштаб от центра блока */
  .s-core-g { transform-box: fill-box; transform-origin: center; animation: s-breathe 4s ease-in-out infinite; }
  @keyframes s-breathe { 50% { transform: scale(1.012); } }
  /* Схема вне экрана — CSS-анимации тоже на паузе (SVG-анимации ставит на паузу скрипт) */
  .fig.is-paused * { animation-play-state: paused; }
</style>
